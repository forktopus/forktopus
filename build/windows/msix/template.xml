<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="forktopus"
        Arguments=""
        InstallLocation="C:\Program Files\Forktopus\Forktopus">
    </Installer>
    <PackageInformation
        PackageName="Forktopus"
        PackageDisplayName="Forktopus"
        PublisherName="CN=Forktopus"
        PublisherDisplayName="Forktopus"
        Version="0.1.1.0"
        PackageDescription="Обзор состояния множества Git-репозиториев">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="ru.forktopus.app"
                Description="Обзор состояния множества Git-репозиториев"
                DisplayName="Forktopus"
                ExecutableName="forktopus"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Forktopus</DisplayName>
            <PublisherDisplayName>Forktopus</PublisherDisplayName>
            <Description>Обзор состояния множества Git-репозиториев</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="forktopus.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
