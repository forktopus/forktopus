# Изменить под свой каталог/пользователя. Файл .env.dev не коммитить.
# Linux: id -u ; id -g
LOCAL_UID=1000
LOCAL_GID=1000

# Фактический Go module path проекта. Можно разместить на любом Git-сервере.
# Пример только после подтверждения владения GitHub-организацией forktopus.
# Если имя занято, заменить на реальный host/owner/repo.
MODULE_PATH=github.com/forktopus/forktopus
